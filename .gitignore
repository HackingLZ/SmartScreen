# Only reviewed project roots are eligible for Git. New root-level output stays
# private by default; add new source roots deliberately.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/smartscreen.py
!/requirements-signatures.txt
!/requirements-vision.txt
!/smartscreen/
!/tests/
!/tools/
!/examples/
!/docs/
!/LICENSE
!/LICENSE.md

# Private research, binaries, downloaded assets and generated state.
local/
analysis/
artifacts/
models/
feeds/
feed_cache/
captures/
downloads/
results/
output/
*.har
*.pcap
*.pcapng
netlog*.json
*.log
